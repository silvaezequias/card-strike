# Copie para .env.local (computador) ou cadastre no painel da Vercel (produção).
# Sem DATABASE_URL, o desenvolvimento usa um banco local em .data/ (PGlite).

# Postgres do Supabase: Project Settings > Database > Connection string > "Transaction pooler" (porta 6543)
DATABASE_URL=

# Segredo das sessões. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Endereço público do site (sem barra no fim), ex.: https://card-strike.vercel.app
APP_URL=

# Supabase: Project Settings > API (tempo real pelo Broadcast)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional (só no servidor, nunca com NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Login com Google: console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login com Discord: discord.com/developers/applications > OAuth2
# Redirect: <APP_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Steam (quando o jogo estiver na Steam): App ID e a Web API Key de editor (partner.steamgames.com)
STEAM_APP_ID=
STEAM_WEB_API_KEY=
